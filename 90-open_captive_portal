#!/bin/sh -e
#
# Runs shows a login webpage on walled garden networks.

# man 8 NetworkManager-dispatcher

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

if [ -x "/usr/bin/logger" ]; then
  logger="/usr/bin/logger -s -t captive-portal"
else
  logger=":"
fi

open_captive() {
  captive_url="http://connectivitycheck.gstatic.com/generate_204"
  uid="$(id -u "$1")" || return 1
  runtime="/run/user/${uid}"

  wl_display=""
  for sock in "$runtime"/wayland-*; do
    if [ -S "$sock" ]; then
      wl_display="${sock##*/}"
      break
    fi
  done
  x_display=""
  for sock in /tmp/.X11-unix/X*; do
    if [ -S "$sock" ] && [ "$(stat -c %u "$sock")" = "$uid" ]; then
      x_display=":${sock##*/X}"
      break
    fi
  done

  sudo -u "$1" env XDG_RUNTIME_DIR="$runtime" \
    ${wl_display:+WAYLAND_DISPLAY="$wl_display"} \
    ${x_display:+DISPLAY="$x_display"} \
    DBUS_SESSION_BUS_ADDRESS=unix:path="${runtime}"/bus \
    xdg-open "${captive_url}"
}

case "$2" in
  connectivity-change)
    $logger -p user.debug \
      "dispatcher script triggered on connectivity change: $CONNECTIVITY_STATE"

    if [ "$CONNECTIVITY_STATE" = "PORTAL" ]; then
      user="${SUDO_USER:-}"
      [ -z "$user" ] && user="$(loginctl list-sessions --no-legend 2>/dev/null | awk 'NR==1{print $3}')"

      $logger "Running browser as '$user' to login in captive portal"

      if [ -n "$user" ]; then
        open_captive "$user" || $logger -p user.err "Failed for user: '$user'"
      else
        $logger -p user.err "Failed to determine logged-in user"
      fi
    fi
    ;;
  *) exit 0 ;;
esac
